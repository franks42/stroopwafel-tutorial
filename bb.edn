{:paths ["src" "notebooks"]

 ;; bb can load the three stroopwafel libraries directly (they're
 ;; bb-compatible). Clay itself is NOT bb-compatible in v2.0.15 —
 ;; its transitive deps (nextjournal.beholder for live-reload,
 ;; scicloj.kind-portal for image support, parcera.antlr for source
 ;; parsing) pull in JVM-only classes that SCI can't resolve. So
 ;; `bb render` and friends shell out to `clojure` for the JVM
 ;; side; see deps.edn for Clay's version.
 :deps {com.github.franks42/stroopwafel     {:mvn/version "0.16.1"}
        com.github.franks42/signet          {:mvn/version "0.10.0"}
        com.github.franks42/stroopwafel-pdp {:mvn/version "0.3.0"}}

 :tasks
 {;; ── Quality ─────────────────────────────────────────────

  lint {:doc  "Lint notebooks + src with clj-kondo"
        :task (shell "clj-kondo" "--lint" "notebooks" "src")}

  fmt  {:doc  "Check formatting with cljfmt"
        :task (shell "cljfmt" "check" "notebooks" "src")}

  fmt:fix {:doc  "Auto-fix formatting"
           :task (shell "cljfmt" "fix" "notebooks" "src")}

  ;; ── Notebook rendering (Clay runs under JVM Clojure) ────

  render
  {:doc  "Render a notebook to HTML.
          Usage: bb render notebooks/01_first_decision.clj"
   :task (let [f (or (first *command-line-args*)
                     (do (println "Usage: bb render <notebook-file>")
                         (System/exit 1)))]
           (shell "clojure" "-M" "-e"
                  (format "(require '[scicloj.clay.v2.api :as clay])
                           (clay/make! {:source-path \"%s\"
                                        :show false
                                        :format [:html]})" f)))}

  serve
  {:doc  "Start Clay's live-rendering server. Edit any notebook file
          and Clay re-renders on save. Default browser opens to the
          preview."
   :task (shell "clojure" "-M" "-e"
                "(require '[scicloj.clay.v2.api :as clay])
                 (clay/make! {:show true :live-reload true})
                 @(promise)")}

  render-all
  {:doc  "Render every notebook in notebooks/ to HTML."
   :task (shell "clojure" "-M" "-e"
                "(require '[scicloj.clay.v2.api :as clay])
                 (clay/make! {:source-path
                              (->> (file-seq (clojure.java.io/file \"notebooks\"))
                                   (filter #(.endsWith (.getName %) \".clj\"))
                                   (map #(.getPath %))
                                   vec)
                              :show false
                              :format [:html]})")}

  preview
  {:doc  "Serve the docs/ output directory on http://localhost:8765.
          Pair with `bb render <file>` to produce the HTML first.
          Runs in the foreground; Ctrl-C to stop. For AI/MCP-driven
          inner loops where `file://` URLs are blocked, this
          provides an HTTP surface that Playwright / Chrome DevTools
          MCPs can navigate to."
   :task (shell "python3" "-m" "http.server" "8765"
                "--directory" "docs")}

  preview:bg
  {:doc  "Same as `preview` but starts the server in the background
          (using nohup). Writes the PID to .preview.pid so a later
          `bb preview:stop` can shut it down. Useful in scripted
          render → navigate → screenshot loops."
   :task (do
           (shell {:out :inherit}
                  "bash" "-c"
                  "nohup python3 -m http.server 8765 --directory docs >/dev/null 2>&1 & echo $! > .preview.pid")
           (println "preview server running on http://localhost:8765")
           (println "stop with: bb preview:stop"))}

  preview:stop
  {:doc  "Stop the background preview server started by `preview:bg`."
   :task (shell {:out :inherit}
                "bash" "-c"
                "if [ -f .preview.pid ]; then kill $(cat .preview.pid) 2>/dev/null; rm -f .preview.pid; echo 'preview server stopped'; else echo 'no .preview.pid found'; fi")}

  ;; ── REPL / quick smoke ──────────────────────────────────

  smoke
  {:doc  "Quick sanity check: load the three libraries and run
          one evaluate/sign/decide round-trip. If this passes,
          the deps and ~/.m2 install are wired correctly."
   :task (shell "clojure" "-M" "-e" "
(require '[stroopwafel.core :as sw]
         '[signet.key :as key]
         '[stroopwafel.pdp.spki.core :as spki]
         '[stroopwafel.pdp.spki.assertion :as a])
(let [r (sw/evaluate {:blocks [{:facts [[:hello :world]]}]}
                     :authorizer {:policies [{:kind :allow
                                              :query [[:hello :world]]}]})]
  (println :stroopwafel-ok? (:valid? r)))
(println :signet-kid-ok? (string? (key/kid (key/signing-keypair))))
(let [root  (key/signing-keypair)
      block (a/sign-block root {:assertions [(a/assertion :capability [\"alice\" :read \"/data\"])]})
      r     (-> (spki/context)
                (spki/add-trust-roots (key/kid root))
                (spki/add-assertions block)
                (spki/decide :policies
                             [{:kind :allow
                               :query [['?s '?t '?nb '?na :capability '?id \"alice\" :read \"/data\"]]}]))]
  (println :spki-decide-ok? (:allowed? r)))")}}}
