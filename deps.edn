{:paths ["src" "notebooks"]

 :deps {org.clojure/clojure {:mvn/version "1.12.4"}

        ;; ── The three-library auth stack ──────────────────────
        ;;
        ;; Currently installed to ~/.m2 locally via the "Path D"
        ;; workflow (see each repo's build.clj and HANDOFF.md §4).
        ;; Not yet on Clojars.
        ;;
        ;; When publishing to Clojars later, nothing here needs to
        ;; change — the :mvn/version coordinates are the same shape
        ;; regardless of whether the jars live in ~/.m2 or Clojars.
        com.github.franks42/stroopwafel     {:mvn/version "0.11.0"}
        com.github.franks42/signet          {:mvn/version "0.3.1"}
        com.github.franks42/stroopwafel-pdp {:mvn/version "0.2.0"}

        ;; ── Notebook renderer ────────────────────────────────
        org.scicloj/clay {:mvn/version "2.0.15"}}

 :aliases
 {;; Test alias for any helper code that needs tests
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; Override stack deps to the live source trees. Useful if you
  ;; need to iterate on library code alongside tutorial content
  ;; without re-installing jars between edits.
  ;;   clojure -M:dev:repl
  :dev  {:override-deps
         {com.github.franks42/stroopwafel     {:local/root "../stroopwafel"}
          com.github.franks42/signet          {:local/root "../signet"}
          com.github.franks42/stroopwafel-pdp {:local/root "../stroopwafel-pdp"}}}}}
